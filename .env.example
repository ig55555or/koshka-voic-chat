# Порт на 127.0.0.1, если Caddy запущен в сети хоста (network_mode: host)
VOICE_PORT=18080
# Docker-сеть Caddy, если он в своей сети (пусто = run.sh определит сам)
CADDY_NETWORK=

# 1 = регистрация открыта всем, 0 = новые аккаунты не создаются
ALLOW_REGISTRATION=1

# --- TURN/STUN (run.sh заполняет сам) ---
# 1 = включён, 0 = выключен
TURN_ENABLED=1
# 1 = весь трафик только через сервер (прямых соединений нет), 0 = пробовать напрямую
RELAY_ONLY=1
# Внешний IP сервера (пусто = определить автоматически)
TURN_EXTERNAL_IP=
# Секретный ключ coturn (пусто = сгенерировать)
TURN_SECRET=
TURN_REALM=voice
TURN_URL=
# Домен и папка с его сертификатом (берётся у Caddy) — для TURN по TLS на порту 5349
TURN_DOMAIN=
TURN_CERT_DIR=
